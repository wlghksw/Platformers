# ====================================
# Market Briefing Pipeline - 환경 변수
# ====================================
# 이 파일을 .env로 복사 후 값을 채워주세요
# cp .env.example .env

# [필수] Anthropic API Key
# https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# [필수] Notion Integration Token
# https://www.notion.so/my-integrations → "새 통합" 생성
NOTION_API_TOKEN=your_notion_token_here

# [필수] Notion 데이터베이스 ID
# 데이터베이스 URL에서 추출: https://www.notion.so/{workspace_name}/{DATABASE_ID}?v=...
NOTION_DATABASE_ID=your_database_id_here

# [선택] Naver 뉴스 API (없으면 Google RSS만 사용)
# https://developers.naver.com/apps
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# [선택] Slack Webhook URL (실패 알림용)
SLACK_WEBHOOK=
